# 이 파일은 "키 이름만" 적어두는 견본이다. 값은 절대 넣지 않는다. (커밋됨)
# 실제 키는 이 파일을 .env 로 복사한 뒤 그쪽에 넣는다. (.env 는 .gitignore 로 차단됨)
#
#   copy .env.example .env
#
# 0단계(가짜 데이터)에서는 아래 키가 하나도 필요 없다.
# 1단계부터 하나씩 채운다.

# --- 1단계: 한국관광공사 TourAPI ---
# 국문/영문 관광정보. data.go.kr 에서 발급.
# 주의: 디코딩된 키를 넣을 것. 인코딩된 키(%2B 등이 섞인 것)를 넣으면 인증 실패한다.
TOUR_API_KEY=

# --- 5단계: YouTube Data API v3 ---
# 쿼터가 하루 10,000 units. search 호출이 100 units 로 가장 비싸다.
YOUTUBE_API_KEY=

# --- 온디맨드: 카카오맵 ---
# 지도 표시(JS 키)와 좌표 변환(REST 키)이 서로 다른 키다.
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- 온디맨드: 한국천문연구원 출몰시각 (일출/일몰) ---
KASI_API_KEY=

# --- 4단계: LLM 태깅 ---
ANTHROPIC_API_KEY=
