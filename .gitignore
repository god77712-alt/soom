# 의존성
/node_modules

# Next.js 빌드 산출물
/.next
/out
next-env.d.ts
tsconfig.tsbuildinfo

# 환경변수 — 실제 키가 들어가는 파일. 절대 커밋 금지.
.env
.env.local
.env.*.local

# 데이터 (1단계 이후 생성. 용량이 크고 재생성 가능하므로 커밋하지 않는다)
# WAL 모드라 -wal / -shm 이 함께 생긴다. 셋 다 빼야 한다.
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/daily.log
/data/raw/
# 제출용 내보내기. 8MB 넘고 npm run export:share 로 언제든 다시 만든다.
/data/share/

# OS / 편집기
.DS_Store
Thumbs.db
*.log

# Local Netlify folder
.netlify
