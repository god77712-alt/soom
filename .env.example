# ═══════════════════════════════════════════════════════════════
#  숨(SOOM) — 환경변수 견본
# ═══════════════════════════════════════════════════════════════
#
#  이 파일은 "키 이름만" 적어두는 견본이다. 값은 절대 넣지 않는다. (깃에 올라감)
#  실제 키는 이 파일을 복사한 .env 에 넣는다. (.env 는 .gitignore 로 차단됨)
#
#      copy .env.example .env
#
#  ⚠️ 키를 채팅창·코드·커밋에 붙여넣지 말 것. 한 번 노출되면 재발급해야 한다.
#
#  [확보]     이미 발급받음
#  [필요]     아직 신청 안 함
#  [선택]     없어도 돌아가지만 있으면 질이 올라감
#
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
#  1. 공공데이터포털 (data.go.kr)
# ───────────────────────────────────────────────────────────────
#
#  ★ 계정당 인증키는 하나다. 승인받은 모든 서비스에 같은 키를 쓴다.
#    관광공사·기상청·천문연 전부 이 키 하나로 호출한다.
#
#  ⚠️ 반드시 "디코딩" 키를 넣을 것.
#     인코딩 키(%2F, %3D%3D 가 섞인 것)를 넣으면 인증에 실패한다.
#     마이페이지에 두 종류가 나란히 있으니 아래쪽(Decoding)을 복사한다.
#
#  ⚠️ 개발계정은 일일 호출 한도가 낮다(보통 1,000건).
#     우리는 약 12만 호출이 필요하다. 마이페이지에서 반드시 운영계정 전환을 신청할 것.
#
DATA_GO_KR_API_KEY=


#  ── 승인받은 관광공사 서비스 (값 입력 불필요 · 참고용) ────────
#
#  [확보] 국문 관광정보          https://apis.data.go.kr/B551011/KorService2
#         → 장소 마스터 + 소개글(태그 원료). 축제·숙박 조회도 이 안에 포함됨
#  [확보] 영문 관광정보          https://apis.data.go.kr/B551011/EngService2
#         → 해외 채널용 장소명·설명
#  [확보] 관광사진 정보          https://apis.data.go.kr/B551011/PhotoGalleryService1
#         → S4 "어떤 그림이 나오나" 의 사진
#  [확보] 관광지별 연관 관광지    https://apis.data.go.kr/B551011/TarRlteTarService1
#         → S4 "근처에 같이 찍을 소재". 좌표 계산보다 정확함
#  [확보] 관광공모전 수상작 사진  https://apis.data.go.kr/B551011/PhokoAwrdService
#         → 상 받은 앵글 = 검증된 촬영 컷
#  [확보] 두루누비(걷기길)        https://apis.data.go.kr/B551011/Durunubi
#         → 완성된 촬영 동선
#  [확보] 기초지자체 중심 관광지  https://apis.data.go.kr/B551011/LocgoHubTarService1
#         → 시군구 단위 대표 관광지. 어드민 커버리지
#  [확보] 지역별 관광 자원 수요   https://apis.data.go.kr/B551011/AreaTarResDemService
#         → S5 어드민 수요 분석
#  [확보] 지역별 관광 다양성      https://apis.data.go.kr/B551011/AreaTarDivService
#         → S5 어드민 다양성 지표
#
#  ── 추가로 신청해야 할 data.go.kr 서비스 ──────────────────────
#
#  [필요] 한국천문연구원 생활천문정보 (출몰시각)
#         → 일출·일몰·박명 시각. S4 ⑤ 촬영 시간의 근거
#  [선택] 기상청 종관기상관측(ASOS) — 과거 관측
#         → "8월 첫째 주 이 지역 맑음 비율 62%" 를 만드는 재료
#  [선택] 기상청 단기예보 조회서비스
#         → "다음 장날 강수확률"
#  [선택] 철도역·열차 시간표 (코레일 / 국가철도공단)
#         → 간이역은 "하루 몇 번 서는지"가 촬영 성패를 가름
#
#  위 서비스들도 승인되면 DATA_GO_KR_API_KEY 하나로 같이 쓴다. 추가 입력 불필요.
#
#  ── 혹시 다른 계정으로 발급받았다면 아래에 따로 넣는다 (보통 비워둠) ──
#
DATA_GO_KR_API_KEY_WEATHER=
DATA_GO_KR_API_KEY_KASI=


# ───────────────────────────────────────────────────────────────
#  2. YouTube Data API v3          [필요]
# ───────────────────────────────────────────────────────────────
#
#  발급: Google Cloud Console → 프로젝트 생성 → "YouTube Data API v3" 사용 설정
#        → 사용자 인증 정보 → API 키
#
#  ⚠️ 무료 쿼터는 하루 10,000 units. search 호출이 100 units 로 가장 비싸다.
#     증액 신청은 심사가 오래 걸리니 지금 넣어둘 것.
#     키를 여러 개 만들어 돌려쓰는 건 약관 위반 소지가 있으니 하지 말 것.
#
YOUTUBE_API_KEY=


# ───────────────────────────────────────────────────────────────
#  3. 카카오맵                      [필요]
# ───────────────────────────────────────────────────────────────
#
#  발급: Kakao Developers → 애플리케이션 추가 → 앱 키
#        같은 앱에서 종류가 다른 키가 여러 개 나온다. 아래 둘은 서로 다른 키다.
#
#  REST API 키 — 서버에서만 쓴다 (주소→좌표 변환, 장소 검색, 길찾기)
KAKAO_REST_API_KEY=
#
#  JavaScript 키 — 브라우저에 노출된다 (지도 표시용)
#  ⚠️ NEXT_PUBLIC_ 로 시작하면 브라우저로 전달된다. 여기에만 이 접두사를 쓸 것.
#  ⚠️ Kakao Developers 에서 반드시 "사이트 도메인"을 등록해 사용을 제한할 것.
NEXT_PUBLIC_KAKAO_JS_KEY=


# ───────────────────────────────────────────────────────────────
#  4. LLM — 소개글→태그 추출, 촬영 구성안 생성    [필요]
# ───────────────────────────────────────────────────────────────
#
#  발급: console.anthropic.com → API Keys
#  4단계에서 장소 4만 건을 전량 배치 태깅한다. 실시간 태깅은 하지 않는다.
#
ANTHROPIC_API_KEY=


# ───────────────────────────────────────────────────────────────
#  5. 키가 필요 없는 데이터 (파일로 받는다)
# ───────────────────────────────────────────────────────────────
#
#  아래는 API 가 아니라 파일을 내려받아 /data/raw/ 에 넣는다.
#  받은 파일 경로만 여기에 적어두면 수집 스크립트가 읽는다.
#
#  [필요] 전통시장 표준데이터 — 공공데이터포털 "표준데이터" 검색
#         → 개설주기(=장날) 가 여기 있다. 없으면 오일장 추천이 무의미해진다
RAW_MARKET_FILE=./data/raw/traditional_market.csv
#
#  [필요] 폐교재산 현황 — 지방교육재정알리미 / 시도교육청
#         → 매각·활용 상태. 절반 이상이 이미 현장에 없다. 상태 필터링 필수
RAW_SCHOOL_FILE=./data/raw/closed_school.csv
#
#  [필요] 인구감소지역 지정 현황 — 행정안전부 고시
#         → is_declining_area 의 원천. 89개 시군구
RAW_DECLINING_AREA_FILE=./data/raw/declining_area.csv
#
#  [선택] 철도역 목록 — 국가철도공단
#         → 간이역·무인역만 추린다
RAW_STATION_FILE=./data/raw/railway_station.csv
#
#  [선택] 한국관광 데이터랩 (datalab.visitkorea.or.kr) — 웹에서 직접 내려받기
#         → 지역별 방문자·체류시간. S5 "생활인구 환산"의 실제 근거
RAW_DATALAB_FILE=./data/raw/datalab_visitors.csv


# ───────────────────────────────────────────────────────────────
#  6. 수집 설정 (키 아님 · 기본값 그대로 두면 됨)
# ───────────────────────────────────────────────────────────────
#
#  SQLite 파일 위치. 2단계부터 생성된다
DATABASE_PATH=./data/soom.db
#
#  수집 체크포인트. 쿼터가 마르면 여기서부터 이어받는다
CHECKPOINT_PATH=./data/checkpoint.json
#
#  API 호출 간격(밀리초). 너무 빠르면 차단당한다
FETCH_DELAY_MS=200
